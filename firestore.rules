rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function participant(data) { return signedIn() && request.auth.uid in data.participantUids; }
    function validOptions(data) {
      return data is map && data.keys().hasOnly(['soundVolume', 'musicVolume', 'sfxVolume'])
        && data.soundVolume is int && data.soundVolume >= 0 && data.soundVolume <= 100
        && data.musicVolume is int && data.musicVolume >= 0 && data.musicVolume <= 100
        && data.sfxVolume is int && data.sfxVolume >= 0 && data.sfxVolume <= 100;
    }
    function editableProfile(data) {
      return data.username is string && data.username.size() > 0 && data.username.size() <= 64
        && data.profilePicture is string && data.profilePicture.size() <= 256
        && data.ui_options is string && data.ui_options.size() <= 64
        && validOptions(data.user_options);
    }
    match /sessions/{sessionId} {
      // Cleanup may remove the live document before a participant reconnects.
      allow get: if signedIn()
        && !exists(/databases/$(database)/documents/sessions/$(sessionId))
        && participant(get(/databases/$(database)/documents/sessions_archive/$(sessionId)).data);
      allow read: if signedIn() && (
        (resource.data.status == 'waiting' && resource.data.isPrivate == false)
        || participant(resource.data));
      allow write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /sessions_archive/{sessionId} {
      allow read: if participant(resource.data);
      allow write: if false;
    }
    match /singleplayer_sessions/{sessionId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
      match /answers/{roundId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/singleplayer_sessions/$(sessionId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'profilePicture', 'user_options', 'ui_options',
          'totalQuestionsAnswered', 'correctAnswers', 'rank', 'ratingPoints', 'rankedGamesPlayed', 'rankedGamesWon'])
        && editableProfile(request.resource.data)
        && request.resource.data.totalQuestionsAnswered == 0
        && request.resource.data.correctAnswers == 0 && request.resource.data.rank == 'unranked'
        && request.resource.data.ratingPoints == 0 && request.resource.data.rankedGamesPlayed == 0
        && request.resource.data.rankedGamesWon == 0;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'profilePicture', 'user_options', 'ui_options'])
        && editableProfile(request.resource.data);
      allow delete: if false;
    }
    match /quizzes/{quizId} { allow read: if signedIn(); allow write: if false; }
    match /ui_presets/{presetId} { allow read: if signedIn(); allow write: if false; }
  }
}
