rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function isPlayerInSession(sessionId) {
      return isSignedIn() && request.auth.uid in sessionDoc(sessionId).playerUids;
    }

    match /sessions/{sessionId} {
      // Matchmaking queries need read on open waiting sessions.
      allow read: if isSignedIn()
        && (resource.data.status == 'waiting'
            || request.auth.uid in resource.data.playerUids);

      allow create: if isSignedIn()
        && request.resource.data.status == 'waiting'
        && request.resource.data.playerUids.size() == 1
        && request.auth.uid in request.resource.data.playerUids;

      allow update: if isSignedIn()
        && (
          resource.data.status == 'waiting'
          && request.resource.data.playerUids.size() <= resource.data.maxPlayers
          && (
            request.auth.uid in request.resource.data.playerUids
            || request.auth.uid in resource.data.playerUids
          )
        )
        || (
          resource.data.status == 'inProgress'
          && request.auth.uid in resource.data.playerUids
          && !(request.auth.uid in request.resource.data.playerUids)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['playerUids', 'players', 'activePlayerCount'])
        );

      allow delete: if isSignedIn()
        && resource.data.status == 'waiting'
        && request.auth.uid in resource.data.playerUids;

      match /answers/{answerId} {
        allow read: if isSignedIn() && isPlayerInSession(sessionId);

        allow create: if isSignedIn()
          && isPlayerInSession(sessionId)
          && request.auth.uid == request.resource.data.uid
          && sessionDoc(sessionId).status == 'inProgress'
          && sessionDoc(sessionId).phase == 'answering'
          && request.resource.data.roundIndex
            == sessionDoc(sessionId).currentQuestionIndex
          && answerId
            == request.auth.uid + '_' + string(request.resource.data.roundIndex)
          && !exists(/databases/$(database)/documents/sessions/$(sessionId)/answers/$(answerId));

        allow update, delete: if false;
      }

      match /roundCounters/{roundId} {
        allow read: if isSignedIn() && isPlayerInSession(sessionId);
        // First counter is created by joinSession (Dart) when the lobby fills.
        allow create: if isSignedIn()
          && isPlayerInSession(sessionId)
          && roundId == '0'
          && request.resource.data.validatedCount == 0
          && request.resource.data.resolved == false;
        allow update, delete: if false;
      }
    }

    match /sessions_archive/{sessionId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/sessions/$(sessionId))
        && request.auth.uid in sessionDoc(sessionId).playerUids;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
